{
  "name": "@bunary/core",
  "version": "0.3.0",
  "description": "Foundation module for Bunary - config, environment, and app helpers",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check ./src ./tests",
    "format": "biome check --write ./src ./tests",
    "pack:check": "bun pm pack --dry-run"
  },
  "keywords": [
    "bunary",
    "bun",
    "backend",
    "framework",
    "config"
  ],
  "author": "Paul Radford",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bunary-dev/core.git"
  },
  "homepage": "https://github.com/bunary-dev/core#readme",
  "bugs": {
    "url": "https://github.com/bunary-dev/core/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2",
    "zod": "^4"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  }
}
